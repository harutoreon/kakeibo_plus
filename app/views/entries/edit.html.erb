<% content_for(:title, '収支の編集') %>

<div class="mx-auto">
  <h1 class="text-4xl text-center mb-7">収支の編集</h1>

  <%= form_with model: @entry do |form| %>
    <div class="mb-3">
      <%= form.label :category, class: 'input' do %>
        <span class="label">収支の種類</span>
        <%= form.text_field :category %>
      <% end %>
    </div>

    <div class="mb-3">
      <%= form.label :genre, class: 'input' do %>
        <span class="label">項目　　　</span>
        <%= form.text_field :genre %>
      <% end %>
    </div>

    <div class="mb-3">
      <%= form.label :product_name, class: 'input' do %>
        <span class="label">商品名　　</span>
        <%= form.text_field :product_name %>
      <% end %>
    </div>

    <div class="mb-3">
      <%= form.label :quantity, class: 'input' do %>
        <span class="label">数量　　　</span>
        <%= form.text_field :quantity %>
      <% end %>
    </div>

    <div class="mb-3">
      <%= form.label :price, class: 'input' do %>
        <span class="label">価格　　　</span>
        <%= form.text_field :price %>
      <% end %>
    </div>

    <div class="mb-3">
      <%= form.label :store_name, class: 'input' do %>
        <span class="label">店名　　　</span>
        <%= form.text_field :store_name %>
      <% end %>
    </div>

    <%= form.submit "更新する", class: 'btn btn-primary' %>
  <% end %>

  <div class="text-center mt-10 underline mb-8">
    <%= link_to '編集をキャンセル', entry_path(@entry) %>
  </div>
</div>
