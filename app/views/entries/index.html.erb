<div>
  <h1 class="font-bold text-4xl">Entries#index</h1>
  <p>Find me in app/views/entries/index.html.erb</p>

  <% @entries.each do |entry| %>
      <%= entry.category %>
      <%= entry.genre %>
      <%= entry.product_name %>
      <%= entry.quantity %> 個
      <%= entry.price %> 円
      <%= button_to "削除する", entry, method: :delete %>
  <% end %>
</div>
