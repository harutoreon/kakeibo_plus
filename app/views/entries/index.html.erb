<% content_for(:title, '収支の一覧') %>

<div class="mx-auto overflow-x-auto">
  <h1 class="text-4xl text-center mb-7">収支の一覧</h1>

  <table class="table">
    <thead>
      <tr>
        <th>収支</th>
        <th>項目</th>
        <th>品名</th>
        <th>数量</th>
        <th>価格（円）</th>
        <th>リソースの削除</th>
      </tr>
    </thead>
    <tbody>
      <% @entries.each_with_index do |entry| %>
        <tr>
          <td><%= entry.category %></td>
          <td><%= entry.genre %></td>
          <td><%= entry.product_name %></td>
          <td><%= entry.quantity %></td>
          <td><%= entry.price %></td>
          <th><%= button_to "削除する", entry, class: 'btn btn-primary', method: :delete %></th>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
